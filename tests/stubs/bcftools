#!/usr/bin/env python3
# A stand-in for bcftools which lets the "call" job scripts be tested without real data.
# Every invocation is logged to $STUB_DIR/calls.log, then:
#   mpileup -- copies its -R regions file to $STUB_DIR/regions_<array index>.txt
#   concat -- writes its input files' contents, in order, to its -o output
#   norm -- writes 'chunk <array index>' to its -o output
#   index -- writes a placeholder to its -o output, or else to <input>.csi
#   merge -- writes a placeholder to its -o output
#   call -- does nothing

import os, shutil, sys

args = sys.argv[1:]
command = args[0]
output = args[args.index("-o") + 1] if "-o" in args else None
stubDir = os.environ["STUB_DIR"]
arrayIndex = os.environ.get("PBS_ARRAY_INDEX", "1")

with open(os.path.join(stubDir, "calls.log"), "a") as fileOut:
    fileOut.write(" ".join(args) + "\n")

if command == "mpileup":
    shutil.copy(args[args.index("-R") + 1], os.path.join(stubDir, f"regions_{arrayIndex}.txt"))
elif command == "concat":
    with open(output, "w") as fileOut:
        for fileName in [ a for a in args[1:] if os.path.isfile(a) ]:
            with open(fileName) as fileIn:
                fileOut.write(fileIn.read())
elif command == "norm":
    with open(output, "w") as fileOut:
        fileOut.write(f"chunk {arrayIndex}\n")
elif command == "index" and output == None:
    with open(args[-1] + ".csi", "w") as fileOut:
        fileOut.write("index\n")
elif output != None:
    with open(output, "w") as fileOut:
        fileOut.write(f"{command}\n")
